{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Security Suite playbook",
  "description": "Version 1 local action allowlist. Notes are literal text, never executable code.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "steps"],
  "properties": {
    "id": {"$ref": "#/$defs/id"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S"},
    "version": {"type": "integer", "const": 1},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "oneOf": [
          {
            "title": "Set triage note and optional status",
            "description": "Replaces the finding's triage note; preserves its status unless supplied.",
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "note"],
            "properties": {
              "action": {"const": "annotate", "type": "string"},
              "note": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S"},
              "status": {"type": "string", "enum": ["new", "acknowledged", "resolved", "false_positive"]}
            }
          },
          {
            "title": "Read response guidance",
            "description": "Returns advice only. Preview uses bundled local advice; live runs may fetch CVE guidance when a provider is configured.",
            "type": "object",
            "additionalProperties": false,
            "required": ["action"],
            "properties": {"action": {"const": "guidance", "type": "string"}}
          },
          {
            "title": "Quarantine detected file",
            "description": "Moves the detected file through the existing remediation rails. Requires a recorded SHA-256; live runs also require confirm=true. Does not isolate a host or block network traffic.",
            "type": "object",
            "additionalProperties": false,
            "required": ["action"],
            "properties": {"action": {"const": "quarantine", "type": "string"}}
          }
        ]
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*(?![\\s\\S])"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playbook", "finding_id"],
      "properties": {
        "playbook": {"oneOf": [{"$ref": "#/$defs/id"}, {"$ref": "#"}]},
        "finding_id": {"$ref": "#/$defs/id"},
        "dry_run": {"type": "boolean", "default": true},
        "confirm": {"type": "boolean", "default": false}
      }
    }
  }
}
