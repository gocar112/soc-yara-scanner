    <OutputType>Exe</OutputType>
    <RootNamespace>SecuritySuite.Cli</RootNamespace>
    <AssemblyName>securitysuite</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SecuritySuite.Core/SecuritySuite.Core.csproj" />
