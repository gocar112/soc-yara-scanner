# Optional VirusTotal adapter. Keep the real key in a local .env file or in
# the process environment; never commit secrets.
VIRUSTOTAL_API_KEY=

# Optional NVD key. NVD works without one at 5 requests / 30 s;
# a free key raises that to 50 / 30 s. https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Read-only OPNsense IDS service status. Use a private IPv4 HTTPS origin.
# Trust your private certificate through the OS trust store or SSL_CERT_FILE.
OPNSENSE_URL=
OPNSENSE_API_KEY=
OPNSENSE_API_SECRET=

# GravityZone setup indicator only; a live Bitdefender connector is not implemented.
BITDEFENDER_API_URL=
BITDEFENDER_API_KEY=
